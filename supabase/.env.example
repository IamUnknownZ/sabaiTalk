# SabaiTalk server-only environment template
# Used for local Supabase Edge Function development.
# For production, configure these as Supabase Edge Function secrets.
#
# NEVER copy SUPABASE_SERVICE_ROLE_KEY, GOOGLE_PLACES_API_KEY,
# or GOOGLE_ROUTES_API_KEY into EXPO_PUBLIC_* variables.

# -------------------------------------------------------------------
# Supabase
# Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------------

# Same Project URL used by the Expo client.
SUPABASE_URL=

# Same anon / public key used by the Expo client.
# Used by the Edge Function to validate requests in the user's context.
SUPABASE_ANON_KEY=

# SERVER ONLY.
# Bypasses RLS and must never be exposed to the mobile/web client.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------
# Google Maps Platform server APIs
# Google Cloud Console -> APIs & Services -> Credentials
# -------------------------------------------------------------------

# Restrict this key to Places API (New).
GOOGLE_PLACES_API_KEY=

# Restrict this key to Routes API.
GOOGLE_ROUTES_API_KEY=
