# SabaiTalk client-safe environment template
# Copy this file to .env.local for local development.
# NEVER place server-only secrets in any EXPO_PUBLIC_* variable.

EXPO_PUBLIC_APP_ENV=development

# -------------------------------------------------------------------
# Supabase client configuration
# Supabase Dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_SUPABASE_URL
#   = Project URL
#
# EXPO_PUBLIC_SUPABASE_ANON_KEY
#   = anon / public key
#
# The anon key is intended for client apps and is protected by RLS.
# NEVER put the service_role key here.
# -------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------
# Google OAuth client IDs
# Optional until Google sign-in is implemented/configured.
# -------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# -------------------------------------------------------------------
# Google Maps SDK for Android
# Google Cloud Console -> APIs & Services -> Credentials
#
# This key should be restricted to:
# - Android apps
# - SabaiTalk Android package
# - Maps SDK for Android
#
# Do NOT use the Places or Routes server key here.
# -------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# -------------------------------------------------------------------
# SERVER-ONLY SECRETS — DO NOT ADD THEM TO THIS FILE
#
# These belong in Supabase Edge Function secrets / server environment:
#
# SUPABASE_SERVICE_ROLE_KEY
# GOOGLE_PLACES_API_KEY
# GOOGLE_ROUTES_API_KEY
#
# See: supabase/.env.example
# -------------------------------------------------------------------
